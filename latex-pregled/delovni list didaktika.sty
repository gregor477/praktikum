\maketitle

\section*{1. Osnovni pojmi}

Zaporedje je funkcija, definirana na naravnih številih:
\[
a_1, a_2, a_3, \dots, a_n
\]

\section*{2. Aritmetično zaporedje}

\[
a_n = a_1 + (n-1)d
\]

\section*{3. Geometrijsko zaporedje}

\[
a_n = a_1 \cdot q^{n-1}
\]

\section*{4. Rekurzivno zaporedje}

Primer:
\[
a_1 = 1,\quad a_n = a_{n-1} + 2
\]

\section*{5. Limita zaporedja}

Primer:
\[
a_n = \frac{1}{n} \to 0
\]

\section*{6. Rešeni primeri}

\textbf{Primer 1:}
\[
a_1 = 4,\ d = 2
\]
\[
a_5 = 4 + 4 \cdot 2 = 12
\]

\textbf{Primer 2:}
\[
a_1 = 3,\ q = 2
\]
\[
a_4 = 3 \cdot 2^3 = 24
\]

\textbf{Primer 3:}
\[
a_n = \frac{2n+1}{n} = 2 + \frac{1}{n} \to 2
\]

\section*{7. Naloge za vajo}

\subsection*{A) Aritmetično zaporedje}
\begin{enumerate}
\item $a_1 = 5, d = 3$ --- izračunaj $a_6$
\item $a_1 = 2, d = -1$ --- izračunaj $a_{10}$
\end{enumerate}

\subsection*{B) Geometrijsko zaporedje}
\begin{enumerate}
\setcounter{enumi}{2}
\item $a_1 = 4, q = 2$ --- izračunaj $a_5$
\item $a_1 = 9, q = \frac{1}{3}$ --- izračunaj $a_4$
\end{enumerate}

\subsection*{C) Prepoznaj zaporedje}
\begin{enumerate}
\setcounter{enumi}{4}
\item $2, 6, 18, 54, \dots$
\item $7, 10, 13, 16, \dots$
\end{enumerate}

\subsection*{D) Limite}
\begin{enumerate}
\setcounter{enumi}{6}
\item $\lim_{n \to \infty} \frac{1}{n}$
\item $\lim_{n \to \infty} \frac{3n}{n+1}$
\item $\lim_{n \to \infty} \frac{n^2}{n^2 + 1}$
\end{enumerate}

\subsection*{E) Malo težje}
\begin{enumerate}
\setcounter{enumi}{9}
\item $a_n = 2n + 1$ --- ali ima limito?
\item $a_n = \left(\frac{1}{2}\right)^n$ --- določi limito
\end{enumerate}

\section*{8. Težje naloge}

\textbf{1.}
\[
a_3 = 7,\quad a_7 = 19
\]
\begin{itemize}
\item določi $a_1$ in $d$
\item zapiši $a_n$
\item izračunaj $a_{20}$
\end{itemize}

\textbf{2.}
\[
a_2 = 6,\quad a_5 = 48
\]
\begin{itemize}
\item določi $q$
\item določi $a_1$
\item zapiši $a_n$
\end{itemize}

\textbf{3.}
\[
\lim_{n \to \infty} \frac{2n^2 + 3n - 1}{n^2 - 5}
\]

\textbf{4.}
\[
a_1 = 1,\quad a_n = a_{n-1} + 2n
\]
\begin{itemize}
\item izračunaj prvih 5 členov
\item ugotovi splošni člen
\end{itemize}

\textbf{5.}
\[
a_n = \frac{n}{n+1}
\]
\begin{itemize}
\item izračunaj prve člene
\item določi limito
\item ali je zaporedje monotono?
\end{itemize}

\textbf{6.}
\[
\lim_{n \to \infty} \left(\sqrt{n^2 + n} - n \right)
\]

\textbf{7.}
\[
a_1 + a_2 + a_3 = 14,\quad a_1 a_2 a_3 = 64
\]
\begin{itemize}
\item določi $a_1$ in $q$
\item zapiši zaporedje
\end{itemize}

